+
+// partialSums is one worker's private running sum, one entry per ciphertext
+// index of the packing layout. Workers never touch the shared accumulators, so
+// no locking is needed: homomorphic addition is associative and commutative in
+// both result and noise growth, so summing the same fresh encryptions in any
+// grouping yields an identical result.
+type partialSums struct {
+	sums []*rlwe.Ciphertext
+	adds int64
 }
+
+func newPartialSums(ciphertextCount int) partialSums {
+	return partialSums{sums: make([]*rlwe.Ciphertext, ciphertextCount)}
+}
+
+// fold adds a fresh encryption into the running sum for ctIdx. The first
+// encryption for an index becomes that sum outright, so a worker performs
+// exactly (its encryptions - 1) adds per ciphertext index it touches.
+func (p *partialSums) fold(ev *bgv.Evaluator, ctIdx int, ct *rlwe.Ciphertext) error {
+	if p.sums[ctIdx] == nil {
+		p.sums[ctIdx] = ct
+		return nil
+	}
+	p.adds++
+	return ev.Add(p.sums[ctIdx], ct, p.sums[ctIdx])
+}
+
+// mergeInto folds this worker's sums into the shared Enc(0) accumulators in
+// `dst` and reports how many adds that took. Single-threaded because it
+// touches shared state, but cheap: at most one add per ciphertext index.
+func (p *partialSums) mergeInto(ev *bgv.Evaluator, dst []*rlwe.Ciphertext) (int64, error) {
+	var adds int64
+	for ctIdx, sum := range p.sums {
+		if sum == nil {
+			continue
+		}
+		if err := ev.Add(dst[ctIdx], sum, dst[ctIdx]); err != nil {
+			return adds, err
+		}
+		adds++
+	}
+	return adds, nil
+}
